{
    "name": "shareglint/laravel",
    "description": "Laravel integration for Shareglint — signed og:image URLs, a Blade component and queued OG image generation for Eloquent models",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "open-graph", "og-image", "social-image", "blade"],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "shareglint/shareglint-php": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": { "Shareglint\\Laravel\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Shareglint\\Laravel\\Tests\\": "tests/" }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../sdk/php",
            "options": { "symlink": true, "versions": { "shareglint/shareglint-php": "1.0.0" } }
        }
    ],
    "extra": {
        "laravel": {
            "providers": ["Shareglint\\Laravel\\ShareglintServiceProvider"],
            "aliases": { "Shareglint": "Shareglint\\Laravel\\Facades\\Shareglint" }
        }
    },
    "scripts": { "test": "pest" },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
